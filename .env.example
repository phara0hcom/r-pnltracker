# Postgres — Neon pooled endpoint, or postgresql://localhost:5432/pnltracker for local
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-northeast-1.aws.neon.tech/neondb?sslmode=require"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (see SETUP.md §2)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Only this address may sign in
ALLOWED_EMAIL="t.elsay3d@gmail.com"

# US quotes (free tier: US equities only, 60 req/min)
FINNHUB_API_KEY=""

# TradingView webhook (exit plans) — generate with: openssl rand -hex 32
# Forms the endpoint path: POST /api/tv/<secret>. Must be 24+ characters or the
# endpoint refuses to accept anything. Unset means the feed is simply off.
TRADINGVIEW_WEBHOOK_SECRET=""

# Web Push (exit-plan notifications) — generate with: npx web-push generate-vapid-keys
# Unset (any of the three) means push notifications are simply off.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# A contact address push services may use to reach you about this key pair.
VAPID_SUBJECT="mailto:you@example.com"
# The browser half — must equal VAPID_PUBLIC_KEY and carry the VITE_ prefix to
# reach the client at all. Inlined at build time, so changing it on Vercel
# needs a redeploy.
VITE_VAPID_PUBLIC_KEY=""

# Error and performance reporting (Sentry, free Developer plan)
# Unset means reporting is simply off — local dev and CI need neither.
# The DSN is public by design; it ships in the client bundle.
SENTRY_DSN=""
# The browser half. Must carry the VITE_ prefix to reach the client at all, and
# it is inlined at build time — setting it on Vercel needs a redeploy to take.
VITE_SENTRY_DSN=""
# Build-only, for uploading source maps. Never exposed to the client.
# The maps themselves are deleted after upload rather than published.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Chart images (Playbook). Leave both unset locally: images go to a gitignored .images/.
# On Vercel, connecting the private Blob store sets BLOB_STORE_ID and authenticates by
# OIDC, so nothing goes here. Only to reach the real store from a local run, set a
# static token for it. Do not use `vercel env pull`, which replaces this file.
# BLOB_READ_WRITE_TOKEN=""
