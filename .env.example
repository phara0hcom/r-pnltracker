# Postgres — Neon pooled endpoint, or postgresql://localhost:5432/pnltracker for local
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-northeast-1.aws.neon.tech/neondb?sslmode=require"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (see SETUP.md §2)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Only this address may sign in
ALLOWED_EMAIL="t.elsay3d@gmail.com"

# US quotes (free tier: US equities only, 60 req/min)
FINNHUB_API_KEY=""

# TradingView webhook (Exit Rules) — generate with: openssl rand -hex 32
# Forms the endpoint path: POST /api/tv/<secret>. Must be 24+ characters or the
# endpoint refuses to accept anything. Unset means the feed is simply off.
TRADINGVIEW_WEBHOOK_SECRET=""
