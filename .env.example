# Postgres — Neon pooled endpoint, or postgresql://localhost:5432/pnltracker for local
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-northeast-1.aws.neon.tech/neondb?sslmode=require"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (see SETUP.md §2)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Only this address may sign in
ALLOWED_EMAIL="t.elsay3d@gmail.com"

# US quotes (free tier: US equities only, 60 req/min)
FINNHUB_API_KEY=""

# TradingView webhook (Exit Rules) — generate with: openssl rand -hex 32
# Forms the endpoint path: POST /api/tv/<secret>. Must be 24+ characters or the
# endpoint refuses to accept anything. Unset means the feed is simply off.
TRADINGVIEW_WEBHOOK_SECRET=""

# Error and performance reporting (Sentry, free Developer plan)
# Unset means reporting is simply off — local dev and CI need neither.
# The DSN is public by design; it ships in the client bundle.
SENTRY_DSN=""
# The browser half. Must carry the VITE_ prefix to reach the client at all, and
# it is inlined at build time — setting it on Vercel needs a redeploy to take.
VITE_SENTRY_DSN=""
# Build-only, for uploading source maps. Never exposed to the client.
# The maps themselves are deleted after upload rather than published.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
